<view class="container"><view class="post-content-card" bindtap="{{m}}"><view class="post-header"><image class="user-avatar" src="{{a}}" mode="aspectFill"></image><view class="user-info"><view class="user-name">{{b}}</view><view class="post-meta"><view class="post-category">{{c}}</view><view class="post-time">{{d}}</view></view></view></view><view class="post-content"><text class="content-text">{{e}}</text><view wx:if="{{f}}" class="post-images"></view></view><view class="post-actions"><view class="action-item" bindtap="{{h}}"><image class="action-icon" src="{{g}}"></image><text class="action-text">分享</text></view><view class="action-item" bindtap="{{l}}"><image class="action-icon" src="{{i}}"></image><text class="{{['action-text', k && 'liked']}}">{{j}}</text></view></view></view><view class="comment-header"><text class="comment-title">全部评论 ({{n}})</text><view class="comment-sort"><text class="sort-item active">最热</text><text class="sort-item">最新</text></view></view><scroll-view class="comment-section" scroll-y style="{{'height:' + w}}" bindscrolltolower="{{x}}"><view class="comment-list"><view wx:if="{{o}}" class="loadingLayout"><uni-load-more wx:if="{{p}}" u-i="0c7fad48-0" bind:__l="__l" u-p="{{p}}"></uni-load-more></view><view wx:for="{{q}}" wx:for-item="comment" wx:key="n" class="comment-item"><image class="comment-avatar" src="{{comment.a}}" mode="aspectFill"></image><view class="comment-content"><view class="comment-info"><text class="comment-name">{{comment.b}}</text><view class="comment-like"><image catchtap="{{comment.c}}" class="comment-like-icon" src="{{comment.d}}"></image><text class="comment-like-count">{{comment.e}}</text><image bindtap="{{comment.f}}" class="comment-more-icon" src="{{'/static/icons/更多.png'}}"></image></view></view><view class="comment-text">{{comment.g}}</view><view class="comment-actions"><text class="comment-time">{{comment.h}}</text><text class="comment-reply" catchtap="{{comment.i}}">回复</text></view><view wx:if="{{comment.j}}" class="sub-comments"><view wx:for="{{comment.k}}" wx:for-item="reply" wx:key="j" class="sub-comment-item"><view class="comment-content"><view class="sub-comment-info"><view class="left"><view><image class="sub-comment-avatar" src="{{reply.a}}" mode="aspectFill"></image></view><view><text class="sub-comment-name" style="text-align:center">{{reply.b}}</text></view></view><view class="right"><view class="sub-comment-like"><image catchtap="{{reply.c}}" class="comment-like-icon" src="{{reply.d}}"></image><text class="comment-like-count">{{reply.e}}</text><image bindtap="{{reply.f}}" class="comment-more-icon" src="{{'/static/icons/更多.png'}}"></image></view></view></view><view class="sub-comment-content">{{reply.g}}</view><view class="sub-comment-actions"><text class="comment-time">{{reply.h}}</text><text class="comment-reply" bindtap="{{reply.i}}">回复</text></view></view></view><view wx:if="{{comment.l}}" class="view-more-replies"><text>展开{{comment.m}}条回复</text></view></view></view></view><view wx:if="{{r}}" class="loadingLayout"><uni-load-more wx:if="{{s}}" u-i="0c7fad48-1" bind:__l="__l" u-p="{{s}}"></uni-load-more></view></view><view wx:if="{{t}}" class="load-more"><text class="load-more-text" bindtap="{{v}}">加载更多评论</text></view><view wx:else class="no-more"><text class="no-more-text">没有更多评论了</text></view></scroll-view><view class="comment-input-container"><view wx:if="{{y}}" class="simpleReply"><text>{{z}}</text></view><view class="comment-input-wrapper"><input class="comment-input" bindinput="{{A}}" placeholder="写下你的评论..." value="{{B}}" focus="{{C}}" bindfocus="{{D}}" bindblur="{{E}}"/><view class="input-actions"><image class="emoji-icon" src="{{F}}" bindtap="{{G}}"></image><button class="{{['send-btn', H && 'active']}}" bindtap="{{I}}" disabled="{{J}}">发送</button></view></view></view></view>