
.safe-area-container.data-v-ebd5ae7a {
  position: fixed;
  right: 10rpx;
  bottom: calc( 100rpx + env(safe-area-inset-bottom, 0px));
  bottom: calc( 100rpx + constant(safe-area-inset-bottom, 0px));
  /* z-index: 1000; */
}
.circle-btn.safe-area-btn.data-v-ebd5ae7a {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #007AFF;
  color: white;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
}

	
/* 触发按钮 */
.trigger-box.data-v-ebd5ae7a{
	padding: 32rpx 40rpx
}

/* 遮罩 */
.mask.data-v-ebd5ae7a{
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.45);
  z-index: 998;
}

/* 半屏抽屉 */
.half-screen-form.data-v-ebd5ae7a{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,.08);
  transform: translateY(100%);
  transition: transform .3s cubic-bezier(.4,0,.2,1);
  z-index: 999;
  display: flex;
  flex-direction: column;
}
.half-screen-form.show.data-v-ebd5ae7a{transform: translateY(0)}

/* 顶部标题 */
.form-header.data-v-ebd5ae7a{
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  color: #1a1a1a;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 表单区 */
form.data-v-ebd5ae7a{
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 40rpx 60rpx;
}

/* 表单项 */
.form-item.data-v-ebd5ae7a{margin-top: 36rpx}
.label.data-v-ebd5ae7a{
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
}
input.data-v-ebd5ae7a,.picker.data-v-ebd5ae7a{
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  transition: border-color .2s;
}
input.data-v-ebd5ae7a:focus,.picker.data-v-ebd5ae7a:focus{
  border-color: #2979ff;
}
.picker.data-v-ebd5ae7a{color: #555}

/* switch 行 */
.switch-item.data-v-ebd5ae7a{
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 保存按钮 */
.submit-btn.data-v-ebd5ae7a{
  margin-top: 60rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #fff;
  border-radius: 12rpx;
  background: linear-gradient(135deg,#2979ff 0%,#4a90e2 100%);
  box-shadow: 0 4rpx 16rpx rgba(41,121,255,.25);
}
.submit-btn.data-v-ebd5ae7a:active{opacity: .92}
