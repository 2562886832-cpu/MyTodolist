
.circle-btn.data-v-e416a595 {
  /* 形状与尺寸 */
  width: 50px;
  height: 50px;
  border-radius: 50%; /* 关键属性：圆形 */
  
  /* 颜色与背景 */
  background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
  color: white;
}
	
/* 触发按钮 */
.trigger-box.data-v-e416a595{
	padding: 32rpx 40rpx
}

/* 遮罩 */
.mask.data-v-e416a595{
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.45);
  z-index: 998;
}

/* 半屏抽屉 */
.half-screen-form.data-v-e416a595{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,.08);
  transform: translateY(100%);
  transition: transform .3s cubic-bezier(.4,0,.2,1);
  z-index: 999;
  display: flex;
  flex-direction: column;
}
.half-screen-form.show.data-v-e416a595{transform: translateY(0)}

/* 顶部标题 */
.form-header.data-v-e416a595{
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  color: #1a1a1a;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 表单区 */
form.data-v-e416a595{
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 40rpx 60rpx;
}

/* 表单项 */
.form-item.data-v-e416a595{margin-top: 36rpx}
.label.data-v-e416a595{
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
}
input.data-v-e416a595,.picker.data-v-e416a595{
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  transition: border-color .2s;
}
input.data-v-e416a595:focus,.picker.data-v-e416a595:focus{
  border-color: #2979ff;
}
.picker.data-v-e416a595{color: #555}

/* switch 行 */
.switch-item.data-v-e416a595{
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 保存按钮 */
.submit-btn.data-v-e416a595{
  margin-top: 60rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #fff;
  border-radius: 12rpx;
  background: linear-gradient(135deg,#2979ff 0%,#4a90e2 100%);
  box-shadow: 0 4rpx 16rpx rgba(41,121,255,.25);
}
.submit-btn.data-v-e416a595:active{opacity: .92}
